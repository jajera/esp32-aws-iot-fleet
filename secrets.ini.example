; Copy to secrets.ini and fill in local values. secrets.ini is gitignored.
; Only override custom_* keys — do not redefine build_flags.

[env]
custom_aws_iot_endpoint = YOUR_ENDPOINT-ats.iot.YOUR_REGION.amazonaws.com
custom_aws_provisioning_template = YOUR_FLEET_TEMPLATE_NAME
custom_wifi_ssid = YOUR_WIFI_SSID
custom_wifi_password = YOUR_WIFI_PASSWORD
